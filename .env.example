# ============================================================
# "Are You Okay?" — AI Family Care Layer Environment Config
# ============================================================

# 1. Local LLM (Ollama) — Primary Provider
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# 2. Free-Tier Cloud Fallbacks (Optional, activated if Ollama is unreachable)
# Free Groq API Key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini API Key (Alternative Free Fallback): https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 3. Speech-to-Text (STT) Settings
# Options: 'tiny', 'base', 'small', 'medium' (local faster-whisper)
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8

# 4. Text-to-Speech (TTS) Settings
# Primary: bn-BD-NabanitaNeural (Female) | Alternative: bn-BD-PradeepNeural (Male)
TTS_VOICE=bn-BD-NabanitaNeural

# 5. Database & Alerts Paths
DB_PATH=data/care_memory.db
ALERTS_FILE=alerts.json
